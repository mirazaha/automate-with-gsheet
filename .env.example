# Copier vers .env : cp .env.example .env
# Ne jamais committer .env (déjà dans .gitignore)

# --- Google Sheets (étape II) ---
# ID dans l'URL : .../d/<SHEET_ID>/edit
SHEET_ID=
# Nom exact de l'onglet (sensible à la casse)
WORKSHEET=

# Local : chemin vers la clé JSON du compte de service (recommandé)
GOOGLE_SA_KEY_PATH=./gcp-service-account.json
# GitHub Actions : tout le JSON dans le secret GOOGLE_SA_KEY_JSON (pas besoin ici)

# --- Supabase Session pooler (étape III) ---
# Host depuis Supabase → Database → Connection string → Session pooler
PG_HOST=aws-0-XXXX.pooler.supabase.com
PG_PORT=5432
PG_USER=postgres.bphoogxfxlgcfkfbhref
PG_PASSWORD=
PG_DB=postgres
PG_TABLE=financial_data
PG_SSLMODE=require
